{
  "name": "moye-markdown-ide",
  "version": "1.0.3",
  "description": "小彭友 · 本地优先的 Markdown 桌面编辑器，内置文档 Agent",
  "main": "./out/main/index.js",
  "author": "MoYe Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:only": "electron-vite build",
    "package": "npm run build && electron-builder --win --publish never",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.7.284",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.8.1",
    "@types/diff": "^8.0.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^13.0.9",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "pinia": "^3.0.4",
    "prettier": "^3.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
